# ARC Blockchain configuration (ACTIVE — testnet)
ARC_NETWORK=testnet
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_USDC_DECIMALS=6
# EVM server wallet (32-byte hex, 0x + 64 hex chars). Fund via https://faucet.circle.com (Arc Testnet)
ARC_WALLET_PRIVATE_KEY=0xYOUR_EVM_PRIVATE_KEY_HERE
# Future mainnet cutover: set ARC_NETWORK=mainnet + explicit ARC_RPC_URL / ARC_CHAIN_ID / ARC_USDC_ADDRESS

# --- DISABLED FOR ARC MIGRATION (kept for future Solana reuse — DO NOT DELETE) ---
# SOLANA_NETWORK=devnet
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SERVER_WALLET_PRIVATE_KEY=[...json array...]
# TOKEN_MINT_ADDRESS=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Unity Validation Configuration
UNITY_VALIDATION_HEADER=X-Unity-Validation
UNITY_VALIDATION_TOKEN=your_unity_validation_token_here

# IP Restrictions (Optional - leave empty to disable)
ALLOWED_IPS=

# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=
SUPABASE_KEY=

# EVM test recipient (0x address) for scripts
TEST_RECIPIENT_ADDRESS=0x0000000000000000000000000000000000000000
